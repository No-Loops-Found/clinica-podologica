{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/inicio", "destination": "/", "permanent": true },
    { "source": "/nutricion", "destination": "/nutricionista/", "permanent": true },
    { "source": "/osteopatia", "destination": "/osteopatia-y-quiromasaje/", "permanent": true },
    { "source": "/blog/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug", "destination": "/:slug/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
