# Base de datos del blog (Turso). En local, usa la de ejemplo: npm run blog:db-local
TURSO_DATABASE_URL=file:blog-local.db
# Token de SOLO LECTURA: turso db tokens create <bd> --read-only (no hace falta con file:)
TURSO_AUTH_TOKEN=
# El mismo valor que en el panel de administración. Genera uno con: openssl rand -hex 32
BLOG_PREVIEW_SECRET=
