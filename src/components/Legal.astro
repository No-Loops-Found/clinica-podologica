---
import Icon from './Icon.astro';
import Dato from './Dato.astro';
import { LEGAL, COLEGIADAS, pendiente } from '../consts';
interface Props { titulo: string; }
const { titulo } = Astro.props;

// El aviso desaparece solo cuando se rellenan todos los datos en consts.ts.
const faltan = [
  ...new Set(
    [...Object.values(LEGAL), ...COLEGIADAS.flatMap((c) => Object.values(c))]
      .filter((v): v is string => typeof v === 'string' && pendiente(v))
      .map((v) => v.slice(1, -1))
  ),
];
---
<div class="wrap py-14 md:py-20">
  <div class="max-w-3xl">
    <p class="eyebrow">Información legal</p>
    <h1 class="mt-3 text-[2.4rem] leading-[1.1] md:text-[3rem]">{titulo}</h1>
    <p class="mt-4 text-[0.95rem] text-muted">Última actualización: <Dato v={LEGAL.actualizado} /></p>

    {faltan.length > 0 && (
      <div class="mt-10 rounded-3xl border-2 border-dashed border-honey/70 bg-sand p-6 md:p-8">
        <p class="flex items-center gap-2 font-semibold text-deep">
          <Icon name="info" size={20} class="text-brand-deep" />
          Faltan datos por completar
        </p>
        <p class="mt-2 text-muted">
          Los datos resaltados en el texto hay que rellenarlos en <code>src/consts.ts</code>
          (<code>LEGAL</code> y <code>COLEGIADAS</code>) antes de publicar.
        </p>
        <ul class="mt-4 space-y-1.5 text-muted">
          {faltan.map((f) => <li class="border-l-2 border-mist-deep pl-4">{f}</li>)}
        </ul>
      </div>
    )}

    <div class="prose-legal mt-8">
      <slot />
    </div>
  </div>
</div>
