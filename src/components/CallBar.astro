---
/**
 * Barra fija inferior en móvil. «Llamar» despliega los tres teléfonos,
 * porque cada especialidad atiende el suyo.
 */
import { PHONES } from '../consts';
import Icon from './Icon.astro';
---
<div id="callbar" class="fixed inset-x-0 bottom-0 z-50 md:hidden">
  <div id="call-sheet" hidden class="mx-3 mb-2 rounded-3xl border border-line bg-white p-2 shadow-lift">
    <p class="px-3 pb-1 pt-2 text-[0.78rem] font-bold uppercase tracking-wider text-brand-deep">¿Con quién quieres hablar?</p>
    <ul>
      {PHONES.map((p) => (
        <li>
          <a href={`tel:${p.tel}`} class="flex items-center gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-mist">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-mist text-brand-deep">
              <Icon name={p.icon} size={20} />
            </span>
            <span class="flex-1 leading-tight">
              <span class="block font-semibold text-deep">{p.area}</span>
              <span class="text-[0.86rem] text-muted">{p.who}</span>
            </span>
            <span class="font-display text-[1.15rem] tabular-nums text-deep">{p.display}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="grid grid-cols-2 border-t border-line bg-paper/95 backdrop-blur" style="padding-bottom: env(safe-area-inset-bottom)">
    <button id="call-btn" type="button"
            class="flex items-center justify-center gap-2 bg-deep py-4 font-semibold text-paper"
            aria-expanded="false" aria-controls="call-sheet">
      <Icon name="phone" size={20} />
      Llamar
    </button>
    <a href="/contacto/" class="flex items-center justify-center gap-2 py-4 font-semibold text-deep">
      <Icon name="pin" size={20} class="text-brand-deep" />
      Cómo llegar
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('callbar');
  const btn = document.getElementById('call-btn');
  const sheet = document.getElementById('call-sheet');

  function setOpen(open: boolean) {
    if (!btn || !sheet) return;
    btn.setAttribute('aria-expanded', String(open));
    sheet.hidden = !open;
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (e) => {
    if (bar && !bar.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
