---
import { SITE, PHONES, NAV, MAPS_URL } from '../consts';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const legales = [
  { href: '/aviso-legal/', label: 'Aviso legal' },
  { href: '/politica-de-privacidad/', label: 'Privacidad' },
  { href: '/politica-de-cookies/', label: 'Cookies' },
  { href: '/declaracion-de-accesibilidad/', label: 'Accesibilidad' },
];
---
<footer class="mt-24 bg-deep text-paper">
  <div class="wrap grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_0.8fr_1fr]">
    <div>
      <img src="/img/logo-blanco.webp" alt="Clínica Podológica Patricia Mateos" width="1050" height="936" class="h-20 w-auto" />
      <p class="mt-5 max-w-[34ch] text-paper/75">
        Podología, nutrición y osteopatía en el centro de Moraleja. Cada especialidad tiene su propio teléfono.
      </p>
      <address class="mt-5 flex items-start gap-2 not-italic text-paper/75">
        <Icon name="pin" size={18} class="mt-1 shrink-0 text-aqua-light" />
        <span>{SITE.street}<br />{SITE.postal} {SITE.city} ({SITE.province})</span>
      </address>
      <a href={MAPS_URL} target="_blank" rel="noopener" class="link-arrow mt-3 text-aqua-light hover:text-white">
        Cómo llegar <Icon name="arrow" size={16} />
      </a>
    </div>

    <div>
      <h2 class="text-[1.1rem] text-white">Teléfonos</h2>
      <ul class="mt-4 space-y-4">
        {PHONES.map((p) => (
          <li>
            <a href={`tel:${p.tel}`} class="group block">
              <span class="block text-[0.78rem] font-bold uppercase tracking-wider text-aqua-light">{p.area} · {p.who}</span>
              <span class="font-display text-[1.4rem] tabular-nums text-white transition-colors group-hover:text-aqua-light">{p.display}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-[1.1rem] text-white">Secciones</h2>
      <ul class="mt-4 space-y-2.5 text-paper/80">
        {NAV.map((i) => <li><a href={i.href} class="transition-colors hover:text-white">{i.label}</a></li>)}
        <li><a href="/servicios/" class="transition-colors hover:text-white">Servicios</a></li>
        <li><a href="/pide-tu-cita/" class="transition-colors hover:text-white">Pide tu cita</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-[1.1rem] text-white">Escríbenos</h2>
      <a href={`mailto:${SITE.email}`}
         class="mt-4 inline-block break-all text-paper/85 underline decoration-aqua-light/50 underline-offset-4 transition-colors hover:text-white">
        {SITE.email}
      </a>
      <p class="mt-3 text-[0.9rem] text-paper/60">
        Para cuestiones administrativas. Si necesitas cita, es más rápido llamar.
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-4 py-6 text-[0.9rem] text-paper/60 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {SITE.name}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {legales.map((l) => <li><a href={l.href} class="transition-colors hover:text-white">{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- Logos de financiación europea: estaban en la web anterior y suelen ser
       obligatorios mientras dure el compromiso de la ayuda. Confirmar con la clínica. -->
  <!-- Los PNG son blancos sobre transparente: solo se ven sobre fondo oscuro. -->
  <div class="bg-abyss">
    <div class="wrap flex flex-wrap items-center gap-x-10 gap-y-3 py-5 opacity-90">
      <img src="/img/ue-financiado.png" alt="Financiado por la Unión Europea, NextGenerationEU" width="1024" height="256" class="h-8 w-auto" />
      <img src="/img/prtr.png" alt="Plan de Recuperación, Transformación y Resiliencia" width="1024" height="576" class="h-10 w-auto" />
    </div>
  </div>
</footer>
