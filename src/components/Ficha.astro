---
/** Ficha completa de una profesional (página del equipo). */
import type { Miembro } from '../data/equipo';
import Icon from './Icon.astro';
interface Props { miembro: Miembro; }
const { miembro: m } = Astro.props;
const iniciales = m.nombre.split(' ').map((p) => p[0]).join('');
---
<article class="card grid overflow-hidden md:grid-cols-[280px_1fr]" id={m.nombre.split(' ')[0].toLowerCase()}>
  <div class="relative bg-mist">
    {m.foto ? (
      <img src={m.foto} alt={m.alt ?? m.nombre} width="560" height="700" loading="lazy"
           class="aspect-[4/5] w-full object-cover object-top md:h-full" />
    ) : (
      <div class="flex aspect-[4/5] w-full items-center justify-center bg-dots md:h-full" aria-hidden="true">
        <span class="flex h-32 w-32 items-center justify-center rounded-full bg-white font-display text-5xl text-brand-deep shadow-soft">
          {iniciales}
        </span>
      </div>
    )}
  </div>

  <div class="p-6 md:p-9">
    <p class="eyebrow">{m.rol}</p>
    <h2 class="mt-2 text-[1.8rem] md:text-[2rem]">{m.nombre}</h2>
    <p class="mt-4 max-w-[62ch] text-[1.05rem]">{m.bio}</p>

    <h3 class="mt-7 font-sans text-[0.78rem] font-bold uppercase tracking-[0.14em] text-muted">Formación y experiencia</h3>
    <ul class="mt-3 space-y-2 text-[0.98rem] text-ink">
      {m.titulacion.map((t) => (
        <li class="flex items-start gap-2.5">
          <Icon name="check" size={18} class="mt-1 shrink-0 text-brand" />
          <span>{t}</span>
        </li>
      ))}
    </ul>

    {m.telDisplay && (
      <a href={`tel:${m.tel}`} class="btn btn-tonal mt-7 tabular-nums">
        <Icon name="phone" size={18} />
        {m.telDisplay}
      </a>
    )}
  </div>
</article>
