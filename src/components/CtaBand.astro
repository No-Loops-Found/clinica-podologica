---
/** Banda final de llamada a la acción con los tres teléfonos. */
import { SITE } from '../consts';
import Directorio from './Directorio.astro';
import Icon from './Icon.astro';
interface Props { titulo?: string; texto?: string; }
const {
  titulo = 'Llama a la especialidad que necesites',
  texto = 'Cada profesional atiende su propio teléfono, así hablas directamente con quien te va a tratar.',
} = Astro.props;
---
<section class="wrap mt-24" aria-labelledby="cta-titulo">
  <div class="relative overflow-hidden rounded-[2rem] bg-deep px-6 py-12 text-paper sm:px-10 md:px-14 md:py-16">
    <div class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-brand/30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-dots-dark [mask-image:radial-gradient(circle_at_85%_15%,black,transparent_55%)]" aria-hidden="true"></div>
    <div class="relative grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
      <div>
        <p class="eyebrow text-aqua-light before:bg-aqua-light">Pide tu cita</p>
        <h2 id="cta-titulo" class="mt-3 text-[2rem] leading-[1.1] text-white md:text-[2.4rem]">{titulo}</h2>
        <p class="mt-4 max-w-[44ch] text-paper/75">{texto}</p>
        <p class="mt-6 flex items-start gap-2 text-[0.95rem] text-paper/70">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-aqua-light" />
          <span>{SITE.street}, {SITE.postal} {SITE.city} ({SITE.province})</span>
        </p>
      </div>
      <Directorio variant="dark" layout="list" />
    </div>
  </div>
</section>
