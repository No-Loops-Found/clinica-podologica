---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const medidas = [
  { icon: 'eye', t: 'Contraste alto', d: 'Todo el texto cumple el contraste mínimo recomendado, también sobre fondos de color.' },
  { icon: 'spark', t: 'Letra ampliada', d: 'El tamaño base es mayor de lo habitual y la web se puede ampliar sin que se rompa.' },
  { icon: 'check', t: 'Foco visible', d: 'Al navegar con teclado siempre se ve dónde estás.' },
  { icon: 'steps', t: 'Estructura ordenada', d: 'Encabezados jerarquizados y zonas con nombre para los lectores de pantalla.' },
  { icon: 'info', t: 'Textos alternativos', d: 'Las imágenes con contenido llevan descripción; las decorativas se ocultan.' },
  { icon: 'sun', t: 'Menos movimiento', d: 'Se respeta la preferencia del sistema de reducir las animaciones.' },
];
---
<Base title="Declaración de accesibilidad | Clínica Podológica Patricia Mateos"
      description="Compromiso de accesibilidad del sitio web de la Clínica Podológica Patricia Mateos.">
  <div class="wrap py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="eyebrow">Accesibilidad</p>
      <h1 class="mt-3 text-[2.4rem] leading-[1.1] md:text-[3rem]">Declaración de accesibilidad</h1>
      <p class="mt-6 text-[1.15rem]">
        Este sitio se ha construido buscando que cualquier persona pueda usarlo, con
        especial atención a quienes navegan con el texto ampliado, con teclado o con
        lector de pantalla.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {medidas.map((m) => (
        <li class="card p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-mist text-brand-deep"><Icon name={m.icon} size={22} /></span>
          <h2 class="mt-4 text-[1.2rem]">{m.t}</h2>
          <p class="mt-2 text-[0.95rem] text-muted">{m.d}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 max-w-3xl rounded-3xl bg-sand p-6 md:p-8">
      <h2 class="text-[1.4rem]">¿Has encontrado alguna barrera?</h2>
      <p class="mt-2 text-muted">Escríbenos y lo corregimos.</p>
      <a href={`mailto:${SITE.email}`} class="link mt-3 inline-block break-all">{SITE.email}</a>
    </div>
    <!-- TODO: la web anterior tenía una declaración más extensa que no se exportó
         completa. Revisar si debe recuperarse el texto original. -->
  </div>
</Base>
