---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Directorio from '../components/Directorio.astro';
import Titulo from '../components/Titulo.astro';
import Icon from '../components/Icon.astro';
import { SITE, MAPS_URL } from '../consts';
---
<Base
  title="Contacto y cómo llegar | Clínica Podológica Patricia Mateos"
  description="Estamos en Calle Jardines 44 bajo, Moraleja (Cáceres). Teléfonos directos de podología, nutrición y osteopatía.">

  <Hero eyebrow="Contacto" tono="sand" titulo="Estamos en el centro de Moraleja"
        entradilla="Llama directamente a la especialidad que necesites. Si prefieres venir, aquí tienes cómo llegar." />

  <section class="wrap py-14 md:py-16" aria-labelledby="tel-titulo">
    <Titulo eyebrow="Teléfonos" id="tel-titulo" intro="Cada profesional atiende su propio número." />
    <div class="mt-8"><Directorio /></div>
  </section>

  <div class="wrap grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
    <section class="card relative overflow-hidden p-7 md:p-10" aria-labelledby="donde-titulo">
      <div class="pointer-events-none absolute inset-y-0 right-0 w-1/2 bg-dots opacity-70 [mask-image:linear-gradient(to_left,black,transparent)]" aria-hidden="true"></div>
      <div class="relative">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-brand-deep"><Icon name="pin" size={24} /></span>
        <h2 id="donde-titulo" class="mt-5 text-[1.7rem]">Dónde estamos</h2>
        <address class="mt-3 text-[1.15rem] not-italic">
          {SITE.street}<br />
          {SITE.postal} {SITE.city} ({SITE.province})
        </address>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={MAPS_URL} target="_blank" rel="noopener" class="btn btn-primary">
            Abrir en Google Maps <Icon name="external" size={17} />
          </a>
          <a href="/pide-tu-cita/" class="btn btn-secondary">Cómo pedir cita</a>
        </div>
        <!-- TODO: pedir a la clínica los datos reales de acceso y aparcamiento
             (escalones, rampa, dónde aparcar, parada de autobús). Es información
             decisiva para pacientes mayores o con movilidad reducida. -->
      </div>
    </section>

    <section class="card p-7 md:p-10" aria-labelledby="mail-titulo">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-brand-deep"><Icon name="mail" size={24} /></span>
      <h2 id="mail-titulo" class="mt-5 text-[1.7rem]">Correo electrónico</h2>
      <p class="mt-3 text-muted">
        Para cuestiones administrativas. Si necesitas cita, es más rápido llamar por teléfono.
      </p>
      <a href={`mailto:${SITE.email}`} class="link mt-4 inline-block break-all">{SITE.email}</a>
      <p class="mt-6 flex items-start gap-2 rounded-2xl bg-sand p-4 text-[0.92rem] text-muted">
        <Icon name="info" size={18} class="mt-0.5 shrink-0 text-brand-deep" />
        <span>Por favor, no envíes datos de salud ni fotografías por correo electrónico. Lo vemos en consulta.</span>
      </p>
    </section>
  </div>
</Base>
